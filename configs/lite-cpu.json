{
  "_comment": "Small model for CPU inference; trains on a single mid-range GPU in a few hours.",
  "preset": "lite",
  "conditioning": "sigma_map",
  "epochs": 120,
  "batch_size": 32,
  "patch_size": 128,
  "patches_per_image": 48,
  "lr": 0.002,
  "warmup_steps": 1000,
  "ema_decay": 0.999,
  "noise_model": "eld",
  "iso_min": 100,
  "iso_max": 12800,
  "loss_weights": {"charbonnier": 1.0, "shadow": 0.3}
}
